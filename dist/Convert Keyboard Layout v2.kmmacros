<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<array>
	<dict>
		<key>UID</key>
		<string>88F621B2-E049-529D-90BC-466255AB80A9</string>
		<key>Name</key>
		<string>Convert Keyboard Layout — US ↔ Hungarian v2</string>
		<key>Activate</key>
		<string>Normal</string>
		<key>IsActive</key>
		<true/>
		<key>Macros</key>
		<array>
			<dict>
				<key>UID</key>
				<string>B30C3FBF-CF0B-5F87-A8CD-C9F730A25994</string>
				<key>Name</key>
				<string>I wanted to type in Hungarian (English → Hungarian)</string>
				<key>IsActive</key>
				<true/>
				<key>Triggers</key>
				<array>
					<dict>
						<key>MacroTriggerType</key>
						<string>HotKey</string>
						<key>Modifiers</key>
