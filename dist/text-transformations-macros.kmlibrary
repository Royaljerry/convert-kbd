    "t": "t",
    "T": "T",
    "1": "1",
    "'": "!",
    "2": "2",
    "\"": "@",
    "3": "3",
    "+": "#",
    "4": "4",
    "!": "$",
    "6": "6",
    "/": "^",
    "5": "5",
    "%": "%",
    "ó": "=",
    "Ó": "+",
    "9": "9",
    ")": "(",
    "7": "7",
    "=": "&amp;",
    "ü": "-",
    "Ü": "_",
    "8": "8",
    "(": "*",
    "ö": "0",
    "Ö": ")",
    "ú": "]",
    "Ú": "}",
    "o": "o",
    "O": "O",
    "u": "u",
    "U": "U",
    "ő": "[",
    "Ő": "{",
    "i": "i",
    "I": "I",
    "p": "p",
    "P": "P",
    "\r": "\r",
    "l": "l",
