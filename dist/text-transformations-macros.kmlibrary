    ".": ".",
    "&gt;": ":",
    "\t": "\t",
    " ": " ",
    "`": "í",
    "~": "Í"
  },
  "toEnglish": {
    "a": "a",
    "A": "A",
    "s": "s",
    "S": "S",
    "d": "d",
    "D": "D",
    "f": "f",
    "F": "F",
    "h": "h",
    "H": "H",
    "g": "g",
    "G": "G",
    "y": "z",
    "Y": "Z",
    "x": "x",
    "X": "X",
    "c": "c",
