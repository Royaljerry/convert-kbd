    "7": "7",
    "&amp;": "=",
    "-": "ü",
    "_": "Ü",
    "8": "8",
    "*": "(",
    "0": "ö",
    ")": "Ö",
    "]": "ú",
    "}": "Ú",
    "o": "o",
    "O": "O",
    "u": "u",
    "U": "U",
    "[": "ő",
    "{": "Ő",
    "i": "i",
    "I": "I",
    "p": "p",
    "P": "P",
    "\r": "\r",
    "l": "l",
    "L": "L",
    "j": "j",
    "J": "J",
    "'": "á",
    "\"": "Á",
    "k": "k",
    "K": "K",
    ";": "é",
    ":": "É",
    "\\": "ű",
    "|": "Ű",
    ",": ",",
    "&lt;": "?",
